{
    "terminal.integrated.minimumContrastRatio": 1,
    "vim.cursorStylePerMode.insert": "line",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.fontSize": 18,
    "terminal.integrated.cursorStyle": "line",
    "editor.fontFamily": "Inconsolata, Menlo, monospace",
    "editor.fontSize": 18,
    "editor.mouseWheelZoom": true,
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "on",
    "editor.guides.bracketPairs": true,
    "editor.minimap.enabled": true,
    "editor.stickyScroll.enabled": false,
    "workbench.startupEditor": "none",
    "workbench.editor.restoreEditors": false,
    "security.workspace.trust.enabled": false,
    "liveServer.settings.NoBrowser": true,
    "claudeCode.enableNewConversationShortcut": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "editor.inlineSuggest.enabled": false,
    "github.copilot.editor.enableAutoCompletions": false,
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    "github.copilot.chat.otel.enabled": true,
    "github.copilot.chat.otel.captureContent": true,
    "github.copilot.chat.otel.captureIdentity": true,
    "chat.agentHost.otel.enabled": true,
    "chat.agentHost.otel.exporterType": "file",
    "chat.agentHost.otel.captureContent": true,
    "chat.agentHost.otel.captureIdentity": true,
    "chat.agentHost.claudeAgent.enabled": false,
    "chat.agentHost.codexAgent.enabled": false,
    "chat.editor.localAgent.enabled": true,
    "chat.defaultToCopilotHarness": false,
    "chat.editor.preferCopilotHarness": false,
    "chat.temporaryDefaultToLocalHarness": true,
    "claudeCode.preferredLocation": "panel",
    "liveServer.settings.donotShowInfoMsg": true,
    "workbench.colorTheme": "p5.js Editor Light"
}